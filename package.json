{
  "name": "mcp-image",
  "mcpName": "io.github.shinpr/mcp-image",
  "version": "0.14.0",
  "packageManager": "pnpm@11.24.0",
  "description": "MCP server for AI image generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-image": "dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "image-generation",
    "generative-ai",
    "image-editing",
    "prompt-enhancement",
    "gemini",
    "google-ai",
    "openai",
    "gpt-image-2.5",
    "nano-banana",
    "claude-code",
    "cursor",
    "codex",
    "typescript",
    "agent-skills",
    "skills"
  ],
  "author": "Shinsuke Kagawa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinpr/mcp-image.git"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/__tests__",
    "!dist/tests",
    "bin",
    "skills"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "link": "pnpm run build && pnpm link",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src",
    "check:deps": "dpdm --no-tree --no-warning --circular --exit-code circular:1 --exclude \"(node_modules|__tests__|\\.test\\.ts$|\\.spec\\.ts$)\" --tsconfig ./tsconfig.json \"src/**/*.ts\"",
    "check:unused": "knip",
    "check:all": "pnpm run check && pnpm run check:deps && pnpm run check:unused && pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openai": "^7.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.20.1",
    "dpdm": "^4.3.0",
    "husky": "^9.1.7",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": "biome check --write --no-errors-on-unmatched"
  }
}
